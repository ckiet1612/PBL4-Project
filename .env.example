# Runtime source: process environment. Nexa does not load this file automatically.
# Required string; PostgreSQL URL. Supply credentials through deployment secret injection.
NEXA_DATABASE_URL=postgresql+psycopg://nexa@localhost/nexa

# Required absolute path; deployment-managed persistent artifact root.
NEXA_ARTIFACT_ROOT=/srv/nexa/artifacts

# Optional enum: development, test, or production.
NEXA_ENVIRONMENT=development

# Optional integer: 65536..16777216 bytes. Default: 1048576.
NEXA_API_JSON_MAX_BYTES=1048576

# Optional enum: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Default: INFO.
NEXA_LOG_LEVEL=INFO
